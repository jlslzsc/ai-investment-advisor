# AI Investment Advisor 配置文件
# 复制此文件为 .env 并填入你的配置

# ============ Notion 同步配置 ============
# 在 https://www.notion.so/my-integrations 创建 Integration 获取
NOTION_API_KEY=ntn_xxx

# Notion 页面 ID（从页面 URL 获取，32位字符）
# 例如: https://www.notion.so/xxx-2f14745dd11880c5a5dcc781a5f39d76
NOTION_PAGE_ID=2f14745dd11880c5a5dcc781a5f39d76

# ============ 数据 API 配置 ============
# Tushare Token（A股数据）
# 注册地址: https://tushare.pro/register
TUSHARE_TOKEN=xxx

# FMP API Key（美股数据）
# 注册地址: https://site.financialmodelingprep.com/developer/docs/
FMP_API_KEY=xxx

# ============ 服务配置 ============
# Web 服务端口
WEB_PORT=80

# 后端服务端口
PORT=8000

# 调试模式
DEBUG=false

# Claude 命令超时时间（秒）
CLAUDE_TIMEOUT=1800
